# HeliosGen is a local-only desktop app. The packaged build sets everything it
# needs at runtime — you only need this file for `pnpm dev` in a browser, and
# even then every value is optional (API keys are normally saved in-app via
# Settings → API Keys and stored in the local SQLite DB).

# Optional fallback custom provider (Settings → API Keys is the normal path).
# Include the API prefix, e.g. https://your-provider.example/v1.
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=
CUSTOM_PROVIDER_IMAGE_PROTOCOL=openai
CUSTOM_PROVIDER_CHAT_PROTOCOL=openai
CUSTOM_PROVIDER_IMAGE_MODEL=
CUSTOM_PROVIDER_CHAT_MODEL=
CUSTOM_PROVIDER_VIDEO_MODEL=

# Optional Azure OpenAI key, only if routing GPT Image 2 through Azure AI Foundry.
AZURE_API_KEY=

# Verbose client logging.
NEXT_PUBLIC_DEBUG=
