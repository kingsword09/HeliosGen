# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/next-desktop/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.job-store.json
.codex-login-store.json

# Guest mode — local DB and generated media
/data/*.json
/data/*.db
/data/*.db-shm
/data/*.db-wal
/public/generated/**
!/public/generated/.gitkeep

# MyGo desktop build artifacts
/.mygo/
/desktop/resources/server/
/desktop/mygo.ts
# Signing / notarization secrets
/scripts/desktop/sign.env
/desktop/.node-cache/
