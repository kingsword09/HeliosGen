{
  "name": "heliosgen",
  "version": "1.2.4",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node scripts/desktop/dev-go.mjs",
    "build": "pnpm web:build",
    "start": "go run ./cmd/helios-server -data ./data -media ./public/generated -listen 127.0.0.1:3000",
    "legacy:dev": "next dev",
    "legacy:build": "next build",
    "legacy:start": "next start -p ${PORT:-3000}",
    "desktop:legacy-server": "node scripts/desktop/build-server.mjs",
    "web:dev": "vite",
    "web:build": "vite build && node scripts/desktop/copy-web-assets.mjs",
    "backend:dev": "go run ./cmd/helios-server -data ./data -media ./public/generated",
    "desktop:check-go": "go run scripts/desktop/check-go-extra.go && node scripts/desktop/check-assistant-stream.mjs && node --experimental-sqlite scripts/desktop/check-go-parity.mjs",
    "desktop:check-integrations": "node scripts/desktop/check-integrations.mjs",
    "desktop:check-task-store": "node --experimental-strip-types scripts/desktop/check-external-task-store.mjs",
    "desktop:check-model-presets": "node scripts/desktop/check-model-presets.mjs",
    "desktop:check-shared": "go test ./internal/server && node scripts/desktop/check-shared-workflow.mjs",
    "lint": "eslint",
    "desktop:dev": "go run github.com/egoist/mygo/cmd/mygo dev",
    "desktop:check-version": "node scripts/desktop/check-version.mjs",
    "desktop:build": "node scripts/desktop/check-version.mjs && go run github.com/egoist/mygo/cmd/mygo build",
    "desktop:doctor": "go run github.com/egoist/mygo/cmd/mygo doctor"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/doto": "^5.3.0",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-github-btn": "^1.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "next": "^16.2.3",
    "sharp": "^0.34.5",
    "undici": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "8.3.7"
  }
}
